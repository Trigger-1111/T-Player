# --- app (Expo/React Native) ---
app/node_modules/
app/.expo/
app/dist/
app/web-build/
app/expo-env.d.ts
app/.kotlin/
app/*.orig.*
app/*.jks
app/*.p8
app/*.p12
app/*.key
app/*.mobileprovision
app/.metro-health-check*
app/npm-debug.*
app/yarn-debug.*
app/yarn-error.*
app/*.tsbuildinfo
app/ios/
app/android/

# Real server URL/API key for this maintainer's device — see app/.env.example
# for the template. For EAS builds these come from `eas env:set` instead.
app/.env

# --- backend (FastAPI) ---
backend/venv/
# Third-party PO token provider server (cloned, not our code - see
# downloader.py docstring for setup steps to reproduce it on a fresh machine)
backend/bgutil-ytdlp-pot-provider/
backend/__pycache__/
backend/**/__pycache__/
backend/*.pyc
backend/.env
backend/library.db
backend/media/
backend/thumbnails/
# YouTube auth cookies (session-equivalent - never commit)
backend/cookies.txt

# --- misc ---
.DS_Store
*.pem
